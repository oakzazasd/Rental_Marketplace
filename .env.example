# Copy this file to `.env` and adjust the values for your environment.
# Never commit the real `.env` file.

# Flask session/CSRF secret. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Database connection string.
# SQLite (development):  sqlite:///absolute/path/to/app.db
# PostgreSQL (later):    postgresql://user:password@localhost:5432/rental_marketplace
DATABASE_URL=sqlite:///app.db

# Absolute or relative folder used to store uploaded item images.
UPLOAD_FOLDER=app/uploads

# Maximum size of a single request (bytes). Default: 5 MB
MAX_CONTENT_LENGTH=5242880

# Set to 1 when serving over HTTPS (secure session/remember cookies).
SESSION_COOKIE_SECURE=0

# Maximum chat message length (characters).
MAX_MESSAGE_LENGTH=2000
